{
  "name": "directus-extension-company-info-manager",
  "version": "0.1.0",
  "description": "Gestor de Información General para Directus: crea teléfonos, correos, redes y ubicación con mutaciones top-level (Items API) que persisten de inmediato, con errores inline del backend. Sin exponer tokens.",
  "type": "module",
  "private": true,
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-interface"
  ],
  "directus:extension": {
    "type": "interface",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.3.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^17.1.0",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.5.4",
    "vue": "^3.4.0"
  }
}
