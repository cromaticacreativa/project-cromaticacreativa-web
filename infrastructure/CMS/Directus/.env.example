# Seguridad y primer Administrador (solo se usan al inicializar una base sin Directus)
SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password

# Debe ser exactamente la misma base configurada en backend/.env mediante MYSQL_*
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cromatica_creativa
DB_USER=replace_me
DB_PASSWORD=replace_me

# Aplicación Directus local
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Storage local provisional; la estrategia definitiva se valida en la PoC de Hostinger
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Recuperación por correo (preparada, pero requiere credenciales SMTP reales)
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=no-reply@example.com
# EMAIL_SMTP_HOST=replace_me
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=replace_me
# EMAIL_SMTP_PASSWORD=replace_me
# EMAIL_SMTP_SECURE=false
