# Bootstrap inicial / administrador humano
SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password

# Provisioning de Directus (Static Access Token; solo server-side y nunca en Git)
DIRECTUS_CONFIG_TOKEN=replace_with_a_directus_static_access_token

# Debe ser exactamente la misma base configurada en backend/.env mediante MYSQL_*
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cromatica_creativa
DB_USER=replace_me
DB_PASSWORD=replace_me

# Aplicación Directus local
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Storage local provisional; la estrategia definitiva se valida en la PoC de Hostinger
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Integración Directus -> Backend NestJS (HU22, Filter Hook bloqueante; ADR-023).
# BACKEND_INTERNAL_URL: origen del backend (sin ruta), p. ej. http://localhost:3000
# BACKEND_INTERNAL_TOKEN: debe ser EXACTAMENTE el mismo valor que CMS_INTERNAL_TOKEN
#   configurado en la .env del backend. Nunca se versiona.
# BACKEND_INTERNAL_TIMEOUT_MS: tiempo máximo de espera (ms) antes de cancelar la
#   creación (fail closed). Opcional; por defecto 5000.
# Si faltan URL o token, el Hook cancela toda creación de phone/email/social_link.
BACKEND_INTERNAL_URL=http://localhost:3000
BACKEND_INTERNAL_TOKEN=replace_with_a_long_random_internal_token
BACKEND_INTERNAL_TIMEOUT_MS=5000

# Mapa OSM/Leaflet dentro de company-info-manager. NO requiere GOOGLE_MAPS_API_KEY
# ni Google Cloud billing. La CSP por defecto de Directus NO incluye el host de
# tiles de OpenStreetMap en `img-src`, por lo que los tiles se ven en gris hasta
# habilitarlo. Directus lee esta variable con el cast `array:` (valores separados
# por coma) y SUSTITUYE la directiva completa, así que se incluyen también los
# valores por defecto de Directus + el host de tiles. `connect-src` NO se toca:
# el valor por defecto de Directus (`https://*`) ya permite consultar Nominatim.
# Descoméntela al desplegar y REINICIE Directus (la CSP se lee al iniciar):
# CONTENT_SECURITY_POLICY_DIRECTIVES__IMG_SRC=array:'self',data:,blob:,https://raw.githubusercontent.com,https://avatars.githubusercontent.com,https://tile.openstreetmap.org

# Recuperación por correo (preparada, pero requiere credenciales SMTP reales)
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=no-reply@example.com
# EMAIL_SMTP_HOST=replace_me
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=replace_me
# EMAIL_SMTP_PASSWORD=replace_me
# EMAIL_SMTP_SECURE=false
