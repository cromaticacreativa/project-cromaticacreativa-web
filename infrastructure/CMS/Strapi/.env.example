# ---------------------------------------------------------------------------
# Strapi 5 — CMS administrativo de Cromática Creativa
# Copie este archivo a `.env` y reemplace los placeholders. NUNCA versione `.env`.
# Genere secretos aleatorios distintos por ambiente (por ejemplo `openssl rand -base64 16`).
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets (obligatorios; genere valores aleatorios reales por ambiente)
# APP_KEYS admite una lista separada por comas.
APP_KEYS=replace_with_random_key_1,replace_with_random_key_2
API_TOKEN_SALT=replace_with_random_salt
ADMIN_JWT_SECRET=replace_with_random_secret
TRANSFER_TOKEN_SALT=replace_with_random_salt
JWT_SECRET=replace_with_random_secret
ENCRYPTION_KEY=replace_with_random_key

# ---------------------------------------------------------------------------
# Database — MISMA base MySQL/MariaDB que el backend (una sola base).
# STRAPI_DB_NAME debe coincidir con MYSQL_DATABASE del backend (p. ej. cromatica_prod).
# NO cree una segunda base. Strapi gobierna solo sus tablas internas propias;
# el schema de las tablas de negocio es autoridad de las TypeORM migrations.
# NO se usa SQLite.
# ---------------------------------------------------------------------------
STRAPI_DB_HOST=127.0.0.1
STRAPI_DB_PORT=3306
# Debe coincidir con MYSQL_DATABASE del backend.
STRAPI_DB_NAME=cromatica_prod
STRAPI_DB_USER=cromatica_app
STRAPI_DB_PASSWORD=replace_with_the_shared_db_secret
STRAPI_DB_SSL=false
# Opcionales de SSL (solo si STRAPI_DB_SSL=true):
# STRAPI_DB_SSL_CA=
# STRAPI_DB_SSL_REJECT_UNAUTHORIZED=true
