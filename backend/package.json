{
  "name": "@cromatica-creativa/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "migration:show": "npm run build && typeorm -d dist/src/Infrastructure/Persistence/TypeOrmDataSource.js migration:show",
    "migration:run": "npm run build && typeorm -d dist/src/Infrastructure/Persistence/TypeOrmDataSource.js migration:run",
    "migration:revert": "npm run build && typeorm -d dist/src/Infrastructure/Persistence/TypeOrmDataSource.js migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "dotenv": "^17.4.2",
    "libphonenumber-js": "1.11.20",
    "mysql2": "^3.23.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}
