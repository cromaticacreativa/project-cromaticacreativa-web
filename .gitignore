# Local environment / secrets
.env
.env.*
!.env.example
!.env.template

# IDE / editor local files
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Test / coverage output
TestResults/
coverage/
coverage.*

# Node.js / TypeScript generated files
**/node_modules/
**/dist/
**/.vite/
**/.cache/
*.tsbuildinfo

# Strapi CMS local runtime (Strapi tiene además su propio .gitignore anidado)
infrastructure/CMS/Strapi/.env
infrastructure/CMS/Strapi/.tmp/
infrastructure/CMS/Strapi/.strapi/
infrastructure/CMS/Strapi/.cache/
infrastructure/CMS/Strapi/build/
infrastructure/CMS/Strapi/dist/
infrastructure/CMS/Strapi/public/uploads/*
!infrastructure/CMS/Strapi/public/uploads/.gitkeep
