MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cromatica_creativa
MYSQL_USER=cromatica_app
MYSQL_PASSWORD=replace_with_a_local_secret
PORT=3000

# Token técnico de la autenticación Directus -> NestJS (ADR-023) usado por los
# endpoints internos /internal/cms/*. Debe ser largo, aleatorio y distinto en
# cada ambiente. Debe coincidir con BACKEND_INTERNAL_TOKEN en la .env de Directus.
# Sin este valor, el endpoint interno queda inaccesible (fail closed).
CMS_INTERNAL_TOKEN=replace_with_a_long_random_internal_token
