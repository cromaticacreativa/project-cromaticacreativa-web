MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cromatica_creativa
MYSQL_USER=cromatica_app
MYSQL_PASSWORD=replace_with_a_local_secret
PORT=3000

# En Hostinger Managed Node usar PORT=3000

# Token técnico reservado para la futura integración service-to-service
# CMS (Strapi) -> NestJS sobre los endpoints internos /internal/cms/*.
# Debe ser largo, aleatorio y distinto en cada ambiente, y coincidir con el valor
# que envíe el CMS. En esta fase la frontera interna no está registrada ni
# expuesta: la autenticación definitiva se implementará junto con la integración
# de Strapi (ver ADR-025). No versionar el valor real.
CMS_INTERNAL_TOKEN=replace_with_a_long_random_internal_token
